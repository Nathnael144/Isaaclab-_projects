.PHONY : codegen_usage

# fast build rule for target.
codegen_usage/fast:
	$(MAKE) $(MAKESILENT) -f docs/examples/cplusplus/CMakeFiles/codegen_usage.dir/build.make docs/examples/cplusplus/CMakeFiles/codegen_usage.dir/build
.PHONY : codegen_usage/fast

